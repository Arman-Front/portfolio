# Хостинг рег.ру (Apache). Попадает в dist/ вместе с остальными файлами из public/

AddDefaultCharset utf-8
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# Сжатие текстовых файлов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Файлы из /assets содержат хэш в имени — их можно кэшировать навсегда
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML всегда перепроверяем, чтобы после деплоя сразу подтягивалась новая версия
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# www.holy-howard.ru → holy-howard.ru
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>
